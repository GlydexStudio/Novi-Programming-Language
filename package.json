    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "keywords": [
    "novi",
    "programming-language",
    "language",
    "interpreter",
    "compiler",
    "glydex-studio"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GlydexStudio/Novi-Programming-Language.git"
  },
  "homepage": "https://github.com/GlydexStudio/Novi-Programming-Language",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "start": "node dist/src/cli/main.js"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  }
