{
  "name": "novi-language",
  "version": "0.1.1",
  "description": "Novi Programming Language — an early developer preview by Glydex Studio.",
  "license": "MIT",
  "author": "Glydex Studio",
  "type": "commonjs",
  "main": "dist/src/index.js",
  "bin": {
    "novi": "dist/src/cli/main.js"
  },
  "files": [
